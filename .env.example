AGENTIC_RAG_APP_NAME=Agentic RAG
AGENTIC_RAG_DEBUG=false

# Choose ollama, codex, or codex-bridge
AGENTIC_RAG_LLM_PROVIDER=ollama
AGENTIC_RAG_OLLAMA_BASE_URL=http://127.0.0.1:11434
AGENTIC_RAG_OLLAMA_MODEL=llama3.2
AGENTIC_RAG_CODEX_EXECUTABLE=codex
# AGENTIC_RAG_CODEX_MODEL=
AGENTIC_RAG_LLM_TIMEOUT_SECONDS=120

# For Docker -> host Codex bridge, set a long random token (keep it private).
# Start the bridge on the host with: python -m scripts.run_codex_bridge
# AGENTIC_RAG_CODEX_BRIDGE_TOKEN=
AGENTIC_RAG_CODEX_BRIDGE_URL=http://host.docker.internal:8765
AGENTIC_RAG_CODEX_BRIDGE_BIND_HOST=127.0.0.1
AGENTIC_RAG_CODEX_BRIDGE_PORT=8765
AGENTIC_RAG_CODEX_BRIDGE_MAX_PROMPT_CHARS=200000

# Chat orchestration: basic or agentic (LangGraph)
AGENTIC_RAG_RAG_MODE=basic
AGENTIC_RAG_AGENTIC_MAX_RETRIES=2

# Optional Web Search (Tavily-compatible API)
AGENTIC_RAG_WEB_SEARCH_ENABLED=false
# AGENTIC_RAG_WEB_SEARCH_API_KEY=
AGENTIC_RAG_WEB_SEARCH_ENDPOINT=https://api.tavily.com/search
AGENTIC_RAG_WEB_SEARCH_MAX_RESULTS=5

# Optional MCP Streamable HTTP server
# AGENTIC_RAG_MCP_SERVER_URL=http://127.0.0.1:8001/mcp
# AGENTIC_RAG_MCP_AUTH_TOKEN=
# MCP must be explicitly allowlisted as a JSON array of retrieval-only tool names.
# AGENTIC_RAG_MCP_ALLOWED_TOOLS=["search"]
AGENTIC_RAG_TOOL_TIMEOUT_SECONDS=20
AGENTIC_RAG_TOOL_RESULT_MAX_CHARS=12000

# Optional Phoenix observability (tracing is off by default)
AGENTIC_RAG_PHOENIX_ENABLED=false
AGENTIC_RAG_PHOENIX_ENDPOINT=http://127.0.0.1:6006/v1/traces
AGENTIC_RAG_PHOENIX_PROJECT_NAME=agentic-rag
# AGENTIC_RAG_PHOENIX_API_KEY=
AGENTIC_RAG_PHOENIX_ENVIRONMENT=development
# Prompts and answers are not sent unless this is explicitly enabled.
AGENTIC_RAG_PHOENIX_CAPTURE_CONTENT=false

# Deterministic evaluation harness
AGENTIC_RAG_EVALUATION_ENDPOINT=http://127.0.0.1:8000/api/v1/chat
AGENTIC_RAG_EVALUATION_TIMEOUT_SECONDS=120
AGENTIC_RAG_EVALUATION_DATASET_PATH=tests/evaluation/rag_cases.json

# Optional Docker host provider URL (set this if Ollama is not on the host).
# OLLAMA_DOCKER_URL=http://host.docker.internal:11434

# Local embeddings and persistent vector database
AGENTIC_RAG_EMBEDDING_PROVIDER=ollama
AGENTIC_RAG_EMBEDDING_MODEL=nomic-embed-text
AGENTIC_RAG_EMBEDDING_TIMEOUT_SECONDS=120
AGENTIC_RAG_EMBEDDING_DOCUMENT_PREFIX="search_document: "
AGENTIC_RAG_EMBEDDING_QUERY_PREFIX="search_query: "
AGENTIC_RAG_CHROMA_PATH=data/chroma
AGENTIC_RAG_CHROMA_COLLECTION=documents
AGENTIC_RAG_CHUNK_SIZE=800
AGENTIC_RAG_CHUNK_OVERLAP=100
